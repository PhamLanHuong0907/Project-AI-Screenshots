# Google Gemini API Key (AI Studio) - Used when Google Gemini provider is selected
GEMINI_API_KEY=

# Anthropic API Key - Optional if using local Claude Code CLI (claude.exe)
ANTHROPIC_API_KEY=

# OpenAI API Key - Used when OpenAI Vision provider is selected
OPENAI_API_KEY=

# Optional default model (e.g., gemini-2.5-flash, sonnet, gpt-4o-mini)
OPENAI_MODEL=gemini-2.5-flash

# Optional custom source and destination directories
# SCREENSHOT_SOURCE_DIR=C:\Users\YourName\Pictures\Screenshots
# SCREENSHOT_DEST_DIR=C:\Users\YourName\Pictures\AI-Screenshots
